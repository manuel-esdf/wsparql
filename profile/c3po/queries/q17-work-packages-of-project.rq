PREFIX c3po: <http://www.esciencedatafactory.com/C3PO/c3po.owl#>

SELECT ?wpName ?allocatedPM
WHERE {
  ?project a c3po:C3PO_0000101 ; c3po:C3PO_0000337 "FAIR-IMPACT" .
  ?wp a c3po:C3PO_0000103 ;
      c3po:C3PO_0000207 ?project ;
      c3po:C3PO_0000338 ?wpName ;
      c3po:C3PO_0000304 ?allocatedPM .
}
ORDER BY ?wpName

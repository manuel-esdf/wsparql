PREFIX c3po: <http://www.esciencedatafactory.com/C3PO/c3po.owl#>

SELECT ?hourlyRate
WHERE {
  ?emp a c3po:C3PO_0000105 ;
       c3po:C3PO_0000340 "Employe2" ;
       c3po:C3PO_0000312 ?annualProductiveHours .
  FILTER(?annualProductiveHours > 0)

  {
    SELECT (SUM(?grossSalary + ?patronalContribution) AS ?annualPersonnelCost) (COUNT(*) AS ?nPayslips) WHERE {
      ?emp a c3po:C3PO_0000105 ; c3po:C3PO_0000340 "Employe2" .
      ?payslip a c3po:C3PO_0000111 ;
                 c3po:C3PO_0000205 ?emp ;
                 c3po:C3PO_0000313 ?grossSalary ;
                 c3po:C3PO_0000314 ?patronalContribution ;
                 c3po:C3PO_0000330 ?yearMonth .
      BIND(SUBSTR(STR(?yearMonth), 1, 4) AS ?payYear)
      FILTER(?payYear = "2022")
    }
  }

  BIND((?annualPersonnelCost / ((?annualProductiveHours / 12) * ?nPayslips)) AS ?hourlyRate)
}

PREFIX c3po: <http://www.esciencedatafactory.com/C3PO/c3po.owl#>

SELECT (COUNT(DISTINCT ?entry) AS ?timesheetCount) (SUM(?hours) AS ?totalHoursWorked)
WHERE {
  ?project a c3po:C3PO_0000101 ; c3po:C3PO_0000337 "FAIR-IMPACT" .
  ?emp c3po:C3PO_0000340 "Employe1" .
  ?ts a c3po:C3PO_0000107 ;
      c3po:C3PO_0000206 ?project ;
      c3po:C3PO_0000202 ?emp ;
      c3po:C3PO_0000301 ?hours ;
      c3po:C3PO_0000347 ?monthOrDay .
  OPTIONAL { ?ts c3po:C3PO_0000209 ?workPackage }
  OPTIONAL { ?ts c3po:C3PO_0000217 ?task }
  BIND(CONCAT(SUBSTR(STR(?monthOrDay), 1, 7), "|",
              STR(COALESCE(?workPackage, "")), "|",
              STR(COALESCE(?task, ""))) AS ?entry)
}

PREFIX c3po: <http://www.esciencedatafactory.com/C3PO/c3po.owl#>
SELECT ?period ?startDate ?endDate
WHERE {
  ?project a c3po:C3PO_0000101 ; c3po:C3PO_0000337 ?projectName .
  ?rp c3po:C3PO_0000204 ?project ;
      c3po:C3PO_0000341 ?period ;
      c3po:C3PO_0000332 ?startDate ;
      c3po:C3PO_0000335 ?endDate .
  FILTER(!BOUND(?kind) || STRSTARTS(?period, ?kind))
}
ORDER BY ?startDate

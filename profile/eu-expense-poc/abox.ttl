@prefix ex: <https://example.org/eu-expense#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Company
ex:ESDF a ex:Company ;
  ex:name "e-Science Data Factory" ;
  ex:country "France" ;
  ex:participatesIn ex:LUMEN, ex:GRAPHIA, ex:OPENSCIENCE .

# Projects
ex:LUMEN a ex:EuropeanProject ;
  ex:name "Linked and Unified Metadata for European Networks" ;
  ex:acronym "LUMEN" ;
  ex:grantAgreement "GA-101000001" ;
  ex:startDate "2025-01-01"^^xsd:date ;
  ex:endDate "2027-12-31"^^xsd:date ;
  ex:budget "420000.00"^^xsd:decimal ;
  ex:hasWorkPackage ex:LUMEN-WP2, ex:LUMEN-WP4 .

ex:GRAPHIA a ex:EuropeanProject ;
  ex:name "Graph Intelligence for European Research" ;
  ex:acronym "GRAPHIA" ;
  ex:grantAgreement "GA-101000002" ;
  ex:startDate "2024-06-01"^^xsd:date ;
  ex:endDate "2027-05-31"^^xsd:date ;
  ex:budget "300000.00"^^xsd:decimal ;
  ex:hasWorkPackage ex:GRAPHIA-WP1, ex:GRAPHIA-WP3 .

ex:OPENSCIENCE a ex:EuropeanProject ;
  ex:name "Open Science Services for Europe" ;
  ex:acronym "OPENSCIENCE" ;
  ex:grantAgreement "GA-101000003" ;
  ex:startDate "2026-01-01"^^xsd:date ;
  ex:endDate "2028-12-31"^^xsd:date ;
  ex:budget "180000.00"^^xsd:decimal ;
  ex:hasWorkPackage ex:OPENSCIENCE-WP2 .

# Work packages
ex:LUMEN-WP2 a ex:WorkPackage ; ex:name "Semantic services" ; ex:belongsToProject ex:LUMEN ; ex:budget "150000.00"^^xsd:decimal .
ex:LUMEN-WP4 a ex:WorkPackage ; ex:name "Integration and validation" ; ex:belongsToProject ex:LUMEN ; ex:budget "120000.00"^^xsd:decimal .
ex:GRAPHIA-WP1 a ex:WorkPackage ; ex:name "Data ingestion" ; ex:belongsToProject ex:GRAPHIA ; ex:budget "90000.00"^^xsd:decimal .
ex:GRAPHIA-WP3 a ex:WorkPackage ; ex:name "Graph analytics" ; ex:belongsToProject ex:GRAPHIA ; ex:budget "110000.00"^^xsd:decimal .
ex:OPENSCIENCE-WP2 a ex:WorkPackage ; ex:name "Service integration" ; ex:belongsToProject ex:OPENSCIENCE ; ex:budget "80000.00"^^xsd:decimal .

# Employees
ex:AliceMartin a ex:Employee ; ex:name "Alice Martin" .
ex:BobDurand a ex:Employee ; ex:name "Bob Durand" .
ex:ClaireRoux a ex:Employee ; ex:name "Claire Roux" .

# Suppliers
ex:AirFrance a ex:Supplier ; ex:name "Air France" ; ex:country "France" .
ex:Eurostar a ex:Supplier ; ex:name "Eurostar" ; ex:country "France" .
ex:CloudHost a ex:Supplier ; ex:name "CloudHost Europe" ; ex:country "Germany" .
ex:SemanticConsulting a ex:Supplier ; ex:name "Semantic Consulting GmbH" ; ex:country "Germany" .
ex:TechStore a ex:Supplier ; ex:name "TechStore SAS" ; ex:country "France" .

# Expenses
ex:E001 a ex:Expense ;
  ex:description "Alice - January personnel cost" ;
  ex:amount "8200.00"^^xsd:decimal ; ex:expenseDate "2026-01-31"^^xsd:date ; ex:eligible true ;
  ex:incurredBy ex:ESDF ; ex:chargedToProject ex:LUMEN ; ex:chargedToWorkPackage ex:LUMEN-WP2 ;
  ex:category ex:Personnel ; ex:employee ex:AliceMartin .

ex:E002 a ex:Expense ;
  ex:description "Bob - January personnel cost" ;
  ex:amount "7600.00"^^xsd:decimal ; ex:expenseDate "2026-01-31"^^xsd:date ; ex:eligible true ;
  ex:incurredBy ex:ESDF ; ex:chargedToProject ex:LUMEN ; ex:chargedToWorkPackage ex:LUMEN-WP4 ;
  ex:category ex:Personnel ; ex:employee ex:BobDurand .

ex:E003 a ex:Expense ;
  ex:description "Trip to Brussels consortium meeting" ;
  ex:amount "680.00"^^xsd:decimal ; ex:expenseDate "2026-02-12"^^xsd:date ; ex:eligible true ;
  ex:incurredBy ex:ESDF ; ex:chargedToProject ex:LUMEN ; ex:chargedToWorkPackage ex:LUMEN-WP4 ;
  ex:category ex:Travel ; ex:employee ex:AliceMartin ; ex:supplier ex:Eurostar .

ex:E004 a ex:Expense ;
  ex:description "Semantic architecture consultancy" ;
  ex:amount "12500.00"^^xsd:decimal ; ex:expenseDate "2026-03-15"^^xsd:date ; ex:eligible true ;
  ex:incurredBy ex:ESDF ; ex:chargedToProject ex:LUMEN ; ex:chargedToWorkPackage ex:LUMEN-WP2 ;
  ex:category ex:Subcontracting ; ex:supplier ex:SemanticConsulting .

ex:E005 a ex:Expense ;
  ex:description "Development laptop" ;
  ex:amount "2900.00"^^xsd:decimal ; ex:expenseDate "2026-03-20"^^xsd:date ; ex:eligible true ;
  ex:incurredBy ex:ESDF ; ex:chargedToProject ex:LUMEN ; ex:chargedToWorkPackage ex:LUMEN-WP2 ;
  ex:category ex:Equipment ; ex:employee ex:AliceMartin ; ex:supplier ex:TechStore .

ex:E006 a ex:Expense ;
  ex:description "Team dinner during project meeting" ;
  ex:amount "240.00"^^xsd:decimal ; ex:expenseDate "2026-03-21"^^xsd:date ; ex:eligible false ;
  ex:incurredBy ex:ESDF ; ex:chargedToProject ex:LUMEN ; ex:chargedToWorkPackage ex:LUMEN-WP2 ;
  ex:category ex:OtherGoodsServices .

ex:E007 a ex:Expense ;
  ex:description "Claire - February personnel cost" ;
  ex:amount "7900.00"^^xsd:decimal ; ex:expenseDate "2026-02-28"^^xsd:date ; ex:eligible true ;
  ex:incurredBy ex:ESDF ; ex:chargedToProject ex:GRAPHIA ; ex:chargedToWorkPackage ex:GRAPHIA-WP3 ;
  ex:category ex:Personnel ; ex:employee ex:ClaireRoux .

ex:E008 a ex:Expense ;
  ex:description "Flight to Vienna review meeting" ;
  ex:amount "920.00"^^xsd:decimal ; ex:expenseDate "2026-04-03"^^xsd:date ; ex:eligible true ;
  ex:incurredBy ex:ESDF ; ex:chargedToProject ex:GRAPHIA ; ex:chargedToWorkPackage ex:GRAPHIA-WP3 ;
  ex:category ex:Travel ; ex:employee ex:ClaireRoux ; ex:supplier ex:AirFrance .

ex:E009 a ex:Expense ;
  ex:description "Cloud hosting for graph pipeline" ;
  ex:amount "3600.00"^^xsd:decimal ; ex:expenseDate "2026-04-30"^^xsd:date ; ex:eligible true ;
  ex:incurredBy ex:ESDF ; ex:chargedToProject ex:GRAPHIA ; ex:chargedToWorkPackage ex:GRAPHIA-WP1 ;
  ex:category ex:OtherGoodsServices ; ex:supplier ex:CloudHost .

ex:E010 a ex:Expense ;
  ex:description "Bob - May personnel cost" ;
  ex:amount "7600.00"^^xsd:decimal ; ex:expenseDate "2026-05-31"^^xsd:date ; ex:eligible true ;
  ex:incurredBy ex:ESDF ; ex:chargedToProject ex:OPENSCIENCE ; ex:chargedToWorkPackage ex:OPENSCIENCE-WP2 ;
  ex:category ex:Personnel ; ex:employee ex:BobDurand .

ex:E011 a ex:Expense ;
  ex:description "Travel to Paris interoperability workshop" ;
  ex:amount "410.00"^^xsd:decimal ; ex:expenseDate "2026-06-14"^^xsd:date ; ex:eligible true ;
  ex:incurredBy ex:ESDF ; ex:chargedToProject ex:OPENSCIENCE ; ex:chargedToWorkPackage ex:OPENSCIENCE-WP2 ;
  ex:category ex:Travel ; ex:employee ex:BobDurand ; ex:supplier ex:Eurostar .

ex:E012 a ex:Expense ;
  ex:description "External API subscription" ;
  ex:amount "1200.00"^^xsd:decimal ; ex:expenseDate "2026-06-30"^^xsd:date ; ex:eligible true ;
  ex:incurredBy ex:ESDF ; ex:chargedToProject ex:OPENSCIENCE ; ex:chargedToWorkPackage ex:OPENSCIENCE-WP2 ;
  ex:category ex:OtherGoodsServices ; ex:supplier ex:CloudHost .

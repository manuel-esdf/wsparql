@prefix ex: <https://example.org/eu-expense#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:EuExpenseOntology a owl:Ontology .

# Opaque IRIs: C = class, P = property, I = individual, numbered in declaration order. The name of a term is its
# rdfs:label (the ETL maps csv file stems, columns and category cells to it, compared as slugs: expenseDate = expense date);
# rdfs:comment = the tag description sent to Ollaya, see GENERATE-TAGS-FROM-ONTOLOGY.md

# Core classes
ex:C01 a owl:Class ; rdfs:label "Company" .
ex:C02 a owl:Class ; rdfs:label "European project" ;
  rdfs:comment "The question concerns one or more European projects" .
ex:C03 a owl:Class ; rdfs:label "Work package" ;
  rdfs:comment "The question concerns a project work package" .
ex:C04 a owl:Class ; rdfs:label "Employee" ;
  rdfs:comment "The question concerns an employee or personnel member" .
ex:C05 a owl:Class ; rdfs:label "Supplier" ;
  rdfs:comment "The question concerns a supplier or external provider" .
ex:C06 a owl:Class ; rdfs:label "Expense" ;
  rdfs:comment "The question concerns company expenses or costs" .
ex:C07 a owl:Class ; rdfs:label "Expense category" ;
  rdfs:comment "The question concerns an expense category" .

# Object properties
ex:P01 a owl:ObjectProperty ;
  rdfs:domain ex:C01 ; rdfs:range ex:C02 ;
  rdfs:label "participates in" .

ex:P02 a owl:ObjectProperty ;
  rdfs:domain ex:C03 ; rdfs:range ex:C02 ;
  rdfs:label "belongs to project" .

ex:P03 a owl:ObjectProperty ;
  rdfs:domain ex:C06 ; rdfs:range ex:C01 ;
  rdfs:label "incurred by" .

ex:P04 a owl:ObjectProperty ;
  rdfs:domain ex:C06 ; rdfs:range ex:C03 ;
  rdfs:label "charged to work package" .

ex:P05 a owl:ObjectProperty ;
  rdfs:domain ex:C06 ; rdfs:range ex:C07 ;
  rdfs:label "category" .

ex:P06 a owl:ObjectProperty ;
  rdfs:domain ex:C06 ; rdfs:range ex:C04 ;
  rdfs:label "employee" .

ex:P07 a owl:ObjectProperty ;
  rdfs:domain ex:C06 ; rdfs:range ex:C05 ;
  rdfs:label "supplier" .

# Datatype properties
ex:P08 a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "name" .
ex:P09 a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "acronym" .
ex:P10 a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "grant agreement" .
ex:P11 a owl:DatatypeProperty ; rdfs:range xsd:date ; rdfs:label "start date" .
ex:P12 a owl:DatatypeProperty ; rdfs:range xsd:date ; rdfs:label "end date" .
ex:P13 a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "budget" ;
  rdfs:comment "The question concerns allocated project budget" .
ex:P14 a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "amount" ;
  rdfs:comment "The question concerns the amount of an expense" .
ex:P15 a owl:DatatypeProperty ; rdfs:range xsd:date ; rdfs:label "expense date" .
ex:P16 a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "description" .
ex:P17 a owl:DatatypeProperty ; rdfs:range xsd:boolean ; rdfs:label "eligible" ;
  rdfs:comment "The question concerns whether costs are eligible" .
ex:P18 a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "country" .

# Expense category individuals
ex:I01 a ex:C07 ; rdfs:label "Personnel" ;
  rdfs:comment "The question concerns personnel costs" .
ex:I02 a ex:C07 ; rdfs:label "Travel" ;
  rdfs:comment "The question concerns travel expenses" .
ex:I03 a ex:C07 ; rdfs:label "Equipment" ;
  rdfs:comment "The question concerns equipment purchases" .
ex:I04 a ex:C07 ; rdfs:label "Subcontracting" ;
  rdfs:comment "The question concerns subcontracting costs" .
ex:I05 a ex:C07 ; rdfs:label "Other goods and services" ;
  rdfs:comment "The question concerns other goods and services costs" .

PREFIX ex: <https://example.org/eu-expense#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?acronym ?categoryName (SUM(?amount) AS ?total)
WHERE {
  ?project a ex:C02 ; ex:P09 ?acronym .
  ?workPackage ex:P02 ?project .
  ?expense a ex:C06 ;
           ex:P04 ?workPackage ;
           ex:P05 ?category ;
           ex:P14 ?amount .
  ?category rdfs:label ?categoryName .
}
GROUP BY ?acronym ?categoryName
ORDER BY DESC(?total)

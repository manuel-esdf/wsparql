PREFIX ex: <https://example.org/eu-expense#>
SELECT ?expense ?description ?date ?amount
WHERE {
  ?project a ex:C02 ; ex:P09 ?acronym .
  ?workPackage ex:P02 ?project .
  ?expense a ex:C06 ;
           ex:P04 ?workPackage ;
           ex:P16 ?description ;
           ex:P15 ?date ;
           ex:P14 ?amount .
  FILTER(?date >= ?from && ?date <= ?to)
}
ORDER BY ?date
